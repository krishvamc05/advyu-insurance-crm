# ADVYU Insurance CRM Funnel Environment Configuration
# Replace placeholders before deploying to production

VITE_BRAND_NAME=ADVYU
VITE_WEBSITE_URL=https://advyu.com

# Official WhatsApp Business API number with country code (e.g. 919160230223)
